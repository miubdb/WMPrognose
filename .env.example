# --- Pflicht ---
# PostgreSQL (z. B. Supabase "Connection string" im Pooler-Modus oder eigener Server)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Mindestens 32 zufällige Zeichen (z. B. `openssl rand -base64 48`); wird zum Hashen der Sitzungs-Token genutzt
SESSION_SECRET=

# --- Optional ---
# Weitere Konten zulassen. Ohne diese Variable kann nur das ERSTE Konto registriert werden (danach ist die Registrierung geschlossen).
ALLOW_REGISTRATION=false
# KI-Funktionen (Coach, Foto-Erkennung). Ohne Schlüssel zeigt die App ehrlich "nicht eingerichtet" an.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_DAILY_LIMIT=40
# DB-SSL abschalten (nur lokal): DATABASE_SSL=disable
# Open-Food-Facts-Nutzungsbedingungen: aussagekräftiger User-Agent mit Kontakt
# OFF_USER_AGENT=RoadToMatchday/1.0 (kontakt@example.com)

# --- NUR für Tests (niemals in Produktion setzen) ---
# APP_ENV_TEST=1
# APP_TODAY=2026-11-02
# COOKIE_SECURE=false   # nur wenn die Produktionsbuild lokal über http läuft
