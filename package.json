{
  "name": "outplay",
  "version": "1.0.0",
  "private": true,
  "description": "OUTPLAY – interaktive Multiplayer-Gameshow",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "bundle:api": "node scripts/bundle-api.mjs",
    "restore": "node scripts/restore-backup.mjs",
    "start:windows": "node scripts/start-local.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "@vercel/blob": "^2.8.2",
    "d3-geo": "^3.1.1",
    "maplibre-gl": "^6.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.19.2",
    "world-atlas": "^2.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vt-pbf": "^3.1.3"
  }
}
