{
  "name": "janiquizition",
  "version": "1.0.0",
  "private": true,
  "description": "JANIQUIZITION – interaktive Multiplayer-Gameshow",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "bundle:api": "node scripts/bundle-api.mjs",
    "restore": "node scripts/restore-backup.mjs",
    "start:windows": "node scripts/start-local.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "@vercel/blob": "^2.9.0",
    "d3-geo": "^3.1.2",
    "maplibre-gl": "^6.19.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "world-atlas": "^2.0.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "pbf": "^5.2.0",
    "pmtiles": "^4.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vt-pbf": "^3.1.3"
  }
}
